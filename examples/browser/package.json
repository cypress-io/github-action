{
  "name": "example-browser",
  "description": "running Cypress using different browsers",
  "type": "module",
  "scripts": {
    "test": "npm run cy:run",
    "info": "cypress info",
    "cy:run": "cypress run",
    "cy:run:chrome": "cypress run --browser chrome",
    "cy:run:edge": "cypress run --browser edge",
    "cy:run:firefox": "cypress run --browser firefox"
  },
  "private": true,
  "devDependencies": {
    "cypress": "16.1.0"
  },
  "allowScripts": {
    "cypress": true
  }
}
